---
permalink: /
layout: default
---
<div class="wrapper">
  <section class="intro">
    <h1 class="intro__title">Welcome to {{ site.shortTitle }}</h1>
    <div class="intro__tagline">
      <p>
        {{ site.tagline }} Personal encounters, reviews, opinions, and the occasional life lesson.
        Read more <a href="/about/">about {{ site.shortTitle }}</a>, or subscribe via
        <a href="/newsletter/" target="_blank" rel="noopener">newsletter</a>
        or <a href="/feed.xml" target="_blank" rel="noopener">RSS</a> to stay updated.
      </p>
    </div>
    {%- comment -%}
      A mandala flower medallion sitting on the divider below the intro, right-aligned.
    {%- endcomment -%}
    <img class="intro__ornament" src="/assets/images/mandala.png" alt="" aria-hidden="true">
  </section>
  {%- if collections.featuredPosts.size > 0 -%}
  <section class="recent-posts">
    <div class="recent-posts__header">
      <h2>Featured posts</h2>
    </div>
    <div class="post-list">
      {%- for post in collections.featuredPosts -%}
        {% include "components/post-preview.liquid" %}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}
  <section class="recent-posts">
    <div class="recent-posts__header">
      <h2>Recent posts</h2>
      <a href="/blog/">View all &rarr;</a>
    </div>
    <div class="post-list">
      {%- assign recentPosts = collections.recentPosts | limit: 9 -%}
      {%- for post in recentPosts -%}
        {% include "components/post-preview.liquid" %}
      {%- endfor -%}
    </div>
  </section>
</div>
